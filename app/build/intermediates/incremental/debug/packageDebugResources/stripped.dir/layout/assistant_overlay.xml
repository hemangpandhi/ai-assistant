<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#60000000"> <!-- Darker, smoother transparent background -->

    <!-- Assistant Bottom Sheet -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPopup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardBackgroundColor="#131314"
        app:cardCornerRadius="32dp"
        app:cardElevation="24dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:paddingBottom="16dp"
            android:paddingHorizontal="24dp">

            <!-- Assistant Logo / Indicator -->
            <ImageView
                android:id="@+id/ivAssistantIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="#A8C7FA"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:contentDescription="Assistant Icon"/>

            <!-- Header / Status -->
            <TextView
                android:id="@+id/assistantStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Hi, how can I help?"
                android:textColor="#E3E3E3"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toTopOf="@id/ivAssistantIcon"
                app:layout_constraintBottom_toBottomOf="@id/ivAssistantIcon"
                app:layout_constraintStart_toEndOf="@id/ivAssistantIcon"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Open App Button (Hidden by default) -->
            <Button
                android:id="@+id/btnOpenApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Open App to Load Model"
                android:textColor="#004A77"
                android:backgroundTint="#C2E7FF"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/assistantStatusText"
                app:cornerRadius="24dp" />

            <!-- Output Text -->
            <ScrollView
                android:id="@+id/svResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:layout_constrainedHeight="true"
                app:layout_constraintHeight_max="250dp"
                app:layout_constraintTop_toBottomOf="@id/assistantStatusText"
                app:layout_constraintBottom_toTopOf="@id/inputControlsContainer">
                
                <TextView
                    android:id="@+id/assistantResponseText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#C4C7C5"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp" />
            </ScrollView>

            <!-- Input Controls Pill Background -->
            <LinearLayout
                android:id="@+id/inputControlsContainer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_input_pill"
                android:paddingHorizontal="8dp"
                app:layout_constraintTop_toBottomOf="@id/svResponse"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageButton
                    android:id="@+id/btnMic"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_btn_speak_now"
                    android:contentDescription="Voice Input"
                    app:tint="#A8C7FA" />

                <EditText
                    android:id="@+id/etInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@null"
                    android:hint="Ask anything..."
                    android:textColorHint="#8E918F"
                    android:textColor="#E3E3E3"
                    android:textSize="16sp"
                    android:inputType="textAutoCorrect|textCapSentences"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <Button
                    android:id="@+id/btnSend"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Send"
                    android:textColor="#A8C7FA"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="?android:selectableItemBackgroundBorderless"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
