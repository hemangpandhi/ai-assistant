<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"> <!-- Darker, smoother transparent background -->

    <!-- Assistant Bottom Sheet -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPopup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardBackgroundColor="#0F0F11"
        app:cardCornerRadius="32dp"
        app:cardElevation="24dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="32dp"
            android:paddingBottom="24dp"
            android:paddingHorizontal="24dp">

            <!-- Assistant Logo Container (Glowing Effect) -->
            <FrameLayout
                android:id="@+id/flIconContainer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_ai_gradient_circle"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                
                <ImageView
                    android:id="@+id/ivAssistantIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_dialog_info"
                    app:tint="#FFFFFF"
                    android:contentDescription="Assistant Icon"/>
            </FrameLayout>

            <!-- Header / Status -->
            <TextView
                android:id="@+id/assistantStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="How can I help you?"
                android:textColor="#E8EAED"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:layout_marginStart="20dp"
                app:layout_constraintTop_toTopOf="@id/flIconContainer"
                app:layout_constraintBottom_toBottomOf="@id/flIconContainer"
                app:layout_constraintStart_toEndOf="@id/flIconContainer"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Open App Button (Hidden by default) -->
            <Button
                android:id="@+id/btnOpenApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Open App to Load Model"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4285F4"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/assistantStatusText"
                app:cornerRadius="24dp" />

            <!-- Output Text -->
            <ScrollView
                android:id="@+id/svResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:layout_constrainedHeight="true"
                app:layout_constraintHeight_max="250dp"
                app:layout_constraintTop_toBottomOf="@id/assistantStatusText"
                app:layout_constraintBottom_toTopOf="@id/inputControlsContainer">
                
                <TextView
                    android:id="@+id/assistantResponseText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#D1D4D9"
                    android:textSize="18sp"
                    android:lineSpacingExtra="6dp" />
            </ScrollView>

            <!-- Input Controls Pill Background -->
            <LinearLayout
                android:id="@+id/inputControlsContainer"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_input_pill"
                android:paddingHorizontal="10dp"
                app:layout_constraintTop_toBottomOf="@id/svResponse"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageButton
                    android:id="@+id/btnMic"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?android:selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_btn_speak_now"
                    android:contentDescription="Voice Input"
                    app:tint="#A8C7FA" />

                <EditText
                    android:id="@+id/etInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@null"
                    android:hint="Ask anything..."
                    android:textColorHint="#707073"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:inputType="textAutoCorrect|textCapSentences"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_send_button">
                    <Button
                        android:id="@+id/btnSend"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="SEND"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@android:color/transparent"
                        android:minWidth="0dp"
                        android:paddingHorizontal="16dp" />
                </FrameLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
