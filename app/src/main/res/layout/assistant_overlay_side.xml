<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardPopup"
        android:layout_width="350dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="24dp">

        <View
            android:id="@+id/blurBackgroundView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_premium_glass"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/localAiIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="@drawable/bg_premium_icon"
            android:src="@drawable/ic_assistant_premium"
            app:tint="#FFFFFF"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/assistantName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EDGE AI"
            android:textColor="#9AA0A6"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="@id/localAiIcon"
            app:layout_constraintBottom_toBottomOf="@id/localAiIcon"
            app:layout_constraintStart_toEndOf="@id/localAiIcon" />

        <ScrollView
            android:id="@+id/svResponse"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toBottomOf="@id/localAiIcon"
            app:layout_constraintBottom_toTopOf="@id/voiceAnimation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/assistantResponseText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="28sp" 
                android:fontFamily="sans-serif-light"
                android:lineSpacingMultiplier="1.1" />
        </ScrollView>

        <com.tcs.vehicleassistant.VoiceAnimationView
            android:id="@+id/voiceAnimation"
            android:layout_width="140dp"
            android:layout_height="60dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnMic" />

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_mic_premium_circle"
            android:src="@drawable/ic_mic_custom"
            app:tint="#A8C7FA"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Hidden elements -->
        <EditText android:id="@+id/etInput" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <Button android:id="@+id/btnSend" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <Button android:id="@+id/btnOpenApp" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <View android:id="@+id/inputControlsContainer" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/assistantStatusText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
