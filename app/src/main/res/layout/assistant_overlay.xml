<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardPopup"
        android:layout_width="0dp"
        android:layout_height="180dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="112dp"
        android:background="@drawable/bg_sdv_obsidian_horizon"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="16dp"
        app:layout_constraintWidth_max="920dp">

        <!-- Hidden elements to satisfy AssistantSession.kt dependencies -->
        <View android:id="@+id/blurBackgroundView" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <ImageView android:id="@+id/localAiIcon" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <EditText android:id="@+id/etInput" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <Button android:id="@+id/btnSend" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <Button android:id="@+id/btnOpenApp" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <View android:id="@+id/inputControlsContainer" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/assistantStatusText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <ImageButton android:id="@+id/btnMic" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />

        <!-- BACKGROUND LAYER: The Live Fluid Waveform -->
        <com.example.gemininano.VoiceAnimationView
            android:id="@+id/voiceAnimation"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- SYSTEM BRANDING TAG -->
        <TextView
            android:id="@+id/assistantName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VEHICLE EDGE AI ASSISTANT"
            android:textColor="#A8C7FA"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.15"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
            
        <!-- MODEL INFORMATION TAG -->
        <TextView
            android:id="@+id/modelInfoTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gemini Nano LiteRT"
            android:textColor="#8AB4F8"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginEnd="24dp"
            android:alpha="0.8"
            app:layout_constraintTop_toTopOf="@id/assistantName"
            app:layout_constraintBottom_toBottomOf="@id/assistantName"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- CONTAINED RESPONSE SCROLLVIEW -->
        <ScrollView
            android:id="@+id/svResponse"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="64dp"
            android:requiresFadingEdge="vertical"
            android:fadingEdgeLength="8dp"
            android:scrollbars="none"
            android:fillViewport="true"
            android:background="@android:color/transparent"
            app:layout_constraintTop_toBottomOf="@id/assistantName"
            app:layout_constraintBottom_toTopOf="@id/voiceAnimation">

            <TextView
                android:id="@+id/assistantResponseText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:textColor="#FFFFFF"
                android:textSize="28sp" 
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:shadowColor="#E6000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="10" />
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
