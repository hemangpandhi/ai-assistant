<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2A2A2A">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Telemetry Settings"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Speed (mph)" android:textColor="#DDDDDD" />
    <EditText android:id="@+id/etSpeed" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="numberDecimal" />



    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI Settings"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"/>

    <Switch
        android:id="@+id/switchCloudFallback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Cloud Fallback"
        android:textColor="#DDDDDD"
        android:layout_marginBottom="16dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Max KV Cache Tokens (Requires Reload)" android:textColor="#DDDDDD" />
    <EditText android:id="@+id/etKvCache" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="number" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Auto Flush Interval (Tests)" android:textColor="#DDDDDD" android:layout_marginTop="8dp"/>
    <EditText android:id="@+id/etAutoFlush" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="number" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Demo &amp; Location"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Demo Preset" android:textColor="#DDDDDD" />
    <Spinner android:id="@+id/spinnerDemoPreset" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Location Source" android:textColor="#DDDDDD" />
    <Spinner android:id="@+id/spinnerLocationSource" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvResolvedLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnApplyDemoPreset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apply Selected Preset"
        android:layout_marginBottom="8dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Manual Coordinates (lon, lat)" android:textColor="#DDDDDD" android:layout_marginTop="8dp"/>
    <EditText android:id="@+id/etLocationOverride" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="text" android:hint="Used when source is Manual, or as GPS fallback" android:textColorHint="#888888" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Contact Mappings"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mechanic Contact Name" android:textColor="#DDDDDD" />
    <EditText android:id="@+id/etMechanicName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="text" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mechanic Phone Number" android:textColor="#DDDDDD" android:layout_marginTop="8dp"/>
    <EditText android:id="@+id/etMechanicNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="phone" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dining / Diet Preference" android:textColor="#DDDDDD" android:layout_marginTop="8dp"/>
    <EditText android:id="@+id/etDiningPref" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Voice AI Settings"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Speaking Rate / Tempo (0.9 - 1.05)" android:textColor="#DDDDDD" />
    <EditText android:id="@+id/etSpeakingRate" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="numberDecimal" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pitch (-1.5 to +0.5)" android:textColor="#DDDDDD" android:layout_marginTop="8dp"/>
    <EditText android:id="@+id/etPitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="numberDecimal|numberSigned" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Volume / Gain (-2.0 to -0.5 dB)" android:textColor="#DDDDDD" android:layout_marginTop="8dp"/>
    <EditText android:id="@+id/etVolume" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="numberDecimal|numberSigned" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Style / Emotion Label (e.g. empathetic)" android:textColor="#DDDDDD" android:layout_marginTop="8dp"/>
    <EditText android:id="@+id/etEmotion" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="text" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Emphasis (e.g. moderate)" android:textColor="#DDDDDD" android:layout_marginTop="8dp"/>
    <EditText android:id="@+id/etEmphasis" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="text" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pauses (ms)" android:textColor="#DDDDDD" android:layout_marginTop="8dp"/>
    <EditText android:id="@+id/etPauses" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="number" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Breath / Filler (ms)" android:textColor="#DDDDDD" android:layout_marginTop="8dp"/>
    <EditText android:id="@+id/etBreath" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="number" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Intensity (0.0 - 1.0)" android:textColor="#DDDDDD" android:layout_marginTop="8dp"/>
    <EditText android:id="@+id/etIntensity" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="numberDecimal" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reverb / FX" android:textColor="#DDDDDD" android:layout_marginTop="8dp"/>
    <EditText android:id="@+id/etReverb" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="text" />

</LinearLayout>
</ScrollView>
