<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardPopup"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_hud_cyberpunk"
        android:padding="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/localAiIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_assistant_premium"
            app:tint="#00F2FE"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/assistantName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="VEHICLE EDGE // SYSTEM: ONLINE"
            android:textColor="#00F2FE"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            app:layout_constraintTop_toTopOf="@id/localAiIcon"
            app:layout_constraintBottom_toBottomOf="@id/localAiIcon"
            app:layout_constraintStart_toEndOf="@id/localAiIcon" />

        <ScrollView
            android:id="@+id/svResponse"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintHeight_max="300dp"
            app:layout_constraintTop_toBottomOf="@id/localAiIcon"
            app:layout_constraintBottom_toTopOf="@id/voiceAnimation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/assistantResponseText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#E0FFFF"
                android:textSize="16sp" 
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.2" />
        </ScrollView>

        <com.example.gemininano.VoiceAnimationView
            android:id="@+id/voiceAnimation"
            android:layout_width="150dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottomControls"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/bottomControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_mic_custom"
                app:tint="#00F2FE" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="[AWAITING INPUT]"
                android:textColor="#00F2FE"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Hidden elements to prevent Kotlin crashes -->
        <EditText android:id="@+id/etInput" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <Button android:id="@+id/btnSend" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <Button android:id="@+id/btnOpenApp" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <View android:id="@+id/inputControlsContainer" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/assistantStatusText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        
        <!-- Dummy blur view to prevent crashes when AssistantSession checks for it -->
        <View android:id="@+id/blurBackgroundView" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
