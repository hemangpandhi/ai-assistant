<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Package Visibility for Navigation intents -->
    <queries>
        <package android:name="org.chromium.webview_shell" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
        </intent>
        
        <!-- Speech Recognition Service Visibility -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="com.google.android.googlequicksearchbox" />
    </queries>

    <!-- Permissions required for downloading the model -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.SET_TIME" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAPTURE_AUDIO_HOTWORD" />
    <uses-permission android:name="android.permission.CAMERA" />
    
    <!-- Permissions required for Car VHAL and Media Control -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
    <uses-permission android:name="android.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="android.car.permission.CONTROL_CAR_SEATS" />
    <uses-permission android:name="android.car.permission.CONTROL_CAR_WINDOWS" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <uses-permission android:name="android.car.permission.READ_INTERIOR_LIGHTS" />
    <uses-permission android:name="android.car.permission.CONTROL_INTERIOR_LIGHTS" />
    <uses-permission android:name="android.car.permission.READ_CAR_EXTERIOR_LIGHTS" />
    <uses-permission android:name="android.car.permission.CONTROL_CAR_EXTERIOR_LIGHTS" />
    
    <!-- Permissions for Vosk Wake Word Background Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Dismiss voice overlay when another app is brought to front (system bar). -->
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".assistant.UiUxVehicleApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_ai_assistant"
        android:label="VehicleEdgeAssistant"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:largeHeap="true"
        android:allowNativeHeapPointerTagging="false"
        android:memtagMode="off"
        android:extractNativeLibs="true"
        android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar">
        
        <!-- Grant access to vendor OpenCL libraries for LiteRT GPU Backend on Android 14+ -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-pixel.so" android:required="false" />
        <uses-native-library android:name="libGLES_mali.so" android:required="false" />

        <activity
            android:name=".LocalLLMActivity"
            android:screenOrientation="reverseLandscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Primary UI/UX VoiceInteractionService (Compose + profile-aware wake). -->
        <service android:name=".assistant.UiUxAssistantVoiceInteractionService"
                 android:permission="android.permission.BIND_VOICE_INTERACTION"
                 android:icon="@drawable/ic_ai_assistant"
                 android:exported="true">
            <meta-data android:name="android.voice_interaction"
                       android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <!-- Legacy refactor VIS — not system-bound; LocalLLMActivity / XML debug only. -->
        <service android:name=".AssistantVoiceInteractionService"
                 android:permission="android.permission.BIND_VOICE_INTERACTION"
                 android:icon="@drawable/ic_mic_small"
                 android:exported="true" />
        
        <!-- Legacy refactor session factory — XML profile still reachable via UiUxAssistantSessionService. -->
        <service android:name=".AssistantSessionService"
                 android:permission="android.permission.BIND_VOICE_INTERACTION"
                 android:exported="true" />

        <!-- Primary session factory: Compose vs XML via AssistantUiProfile. -->
        <service android:name=".assistant.UiUxAssistantSessionService"
                 android:permission="android.permission.BIND_VOICE_INTERACTION"
                 android:exported="true" />
                 
        <!-- Legacy refactor agent service — XML AssistantSession path only. -->
        <service android:name=".service.VehicleAgentService"
                 android:foregroundServiceType="dataSync"
                 android:exported="false" />

        <!-- Primary Compose agent host. -->
        <service android:name=".service.UiUxVehicleAgentService"
                 android:foregroundServiceType="dataSync"
                 android:exported="false" />
                 
        <!-- Legacy refactor wake word — XML profile / LocalLLMActivity. -->
        <service android:name=".WakeWordService"
                 android:process=":wakeword"
                 android:foregroundServiceType="microphone"
                 android:exported="true" />

        <!-- Primary Compose wake word (:wakeword process). -->
        <service android:name=".wakeword.UiUxWakeWordService"
                 android:process=":wakeword"
                 android:foregroundServiceType="microphone"
                 android:exported="true" />
                 
        <activity
            android:name=".CockpitAwarenessActivity"
            android:screenOrientation="reverseLandscape"
            android:exported="true" />

        <service android:name=".vision.CockpitVisionService"
                 android:foregroundServiceType="camera"
                 android:exported="false" />

        <!-- Compose design assistant entry points (UI decoupled from agent core) -->
        <activity
            android:name=".assistant.UiUxOverlayActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="com.tcs.vehicleassistant.action.OPEN_UIUX_OVERLAY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.assistant.ui.assistant.entry.VirtualAssistantActivity"
            android:exported="true"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="com.assistant.ui.action.OPEN_ASSISTANT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.assistant.ui.assistant.ui.gallery.AssistantUiGalleryActivity"
            android:exported="true"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar">
            <intent-filter>
                <action android:name="com.assistant.ui.action.OPEN_ASSISTANT_GALLERY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.assistant.ui.assistant.ui.overlay.AssistantOverlayBootstrapActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="com.assistant.ui.action.START_ASSISTANT_OVERLAY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name="com.assistant.ui.assistant.ui.immersive.ImmersiveAssistantOverlayService"
            android:exported="true" />

        <service
            android:name="com.assistant.ui.assistant.ui.overlay.AssistantOverlayService"
            android:exported="false" />

        <receiver
            android:name="com.assistant.ui.assistant.face.AssistantFaceReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.assistant.ui.action.SET_ASSISTANT_FACE" />
                <action android:name="com.assistant.ui.action.GET_ASSISTANT_FACE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.assistant.ui.assistant.api.AssistantDebugStripReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.assistant.ui.action.SET_ASSISTANT_DEBUG_STRIP" />
                <action android:name="com.assistant.ui.action.GET_ASSISTANT_DEBUG_STRIP" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".assistant.AssistantUiProfileReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.tcs.vehicleassistant.action.SET_ASSISTANT_UI" />
                <action android:name="com.tcs.vehicleassistant.action.GET_ASSISTANT_UI" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".assistant.AssistantIdleTimeoutReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.tcs.vehicleassistant.action.SET_IDLE_TIMEOUT" />
                <action android:name="com.tcs.vehicleassistant.action.GET_IDLE_TIMEOUT" />
            </intent-filter>
        </receiver>
                 
        <service android:name="audio.soniqo.speech.service.SpeechRecognitionService"
                 android:permission="android.permission.BIND_RECOGNITION_SERVICE"
                 android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>

</manifest>
