<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Drop Shadow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <corners android:radius="50dp" />
        </shape>
    </item>
    
    <!-- Main Glass Body -->
    <item android:bottom="2dp" android:right="2dp" android:left="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#B31A1C20" /> <!-- Dark frosted acrylic -->
            <corners android:radius="50dp" />
            
            <!-- Simulated Inner Bevel Edge (Highlights) -->
            <stroke
                android:width="1.5dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>
