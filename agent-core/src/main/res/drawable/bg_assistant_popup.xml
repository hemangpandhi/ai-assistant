<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Semi-transparent gradient to give a glassmorphism/premium feel -->
    <!-- Start: Deep violet, 90% opacity. End: Almost black, 90% opacity -->
    <gradient
        android:type="radial"
        android:centerX="0.5"
        android:centerY="1.0"
        android:gradientRadius="800dp"
        android:startColor="#E61A0B2E"
        android:endColor="#E6050510" />
        
    <corners android:radius="32dp" />
    
    <!-- Subtle glowing border -->
    <stroke
        android:width="1dp"
        android:color="#3300E5FF" />
</shape>
