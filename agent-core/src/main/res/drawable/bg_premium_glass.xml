<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <!-- Sleek sapphire to charcoal gradient to mimic curved premium glass -->
            <gradient
                android:startColor="#E60A0E17"
                android:endColor="#E605060A"
                android:angle="135" />
            <corners android:radius="32dp" />
            <stroke
                android:width="1dp"
                android:color="#4DA8C7FA" /> 
        </shape>
    </item>
</layer-list>
